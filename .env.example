# Application
NODE_ENV=development
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL
DATABASE_URL=postgresql://oilmart:oilmart_dev_password@localhost:55432/oilmart?schema=public

# Optional external providers. Empty means unavailable and never reports delivery.
# For local-only previews use EMAIL_PROVIDER=development and/or SMS_PROVIDER=development.
# Development preview disclosure is disabled when NODE_ENV=production.
SENTRY_DSN=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
EMAIL_PROVIDER=
SMS_PROVIDER=

# One-time secure owner bootstrap (never commit real values)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
