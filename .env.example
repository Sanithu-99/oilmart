# Application
NODE_ENV=development
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Generate a unique value of at least 32 characters for each environment.
AUTH_SECRET=

# PostgreSQL
# Supply a PostgreSQL connection string through your local or hosting environment.
DATABASE_URL=

# Optional external providers. Empty means unavailable and never reports delivery.
# For local-only previews use EMAIL_PROVIDER=development and/or SMS_PROVIDER=development.
# Development preview disclosure is disabled when NODE_ENV=production.
SENTRY_DSN=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
EMAIL_PROVIDER=
SMS_PROVIDER=

# One-time secure owner bootstrap (never commit real values)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# Optional private SMSGate API base, ending in /3rdparty/v1
SMS_GATE_URL=
SMS_GATE_TOKEN=
SMS_GATE_DEVICE_ID=
SMS_GATE_SIM_NUMBER=
